// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  passwordHash  String?
  firstName     String?
  lastName      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roles UserRole[]

  avatarId String?
  avatar   ImageAsset? @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  provider   AuthProvider @default(LOCAL)
  providerId String?      @unique

  sessions         AuthSession[]
  verifyTokens     EmailVerifyToken[]
  resetTokens      PasswordResetToken[]
  ownedHotels      Hotel[]
  hotelMemberships HotelMember[]        @relation("UserHotelMemberships")
  galleries        ImageGallery[]
  folderGalleries  FolderGallery[]
}

model Hotel {
  id          String  @id @default(cuid())
  name        String
  address     String?
  city        String?
  country     String?
  description String?

  status HotelStatus @default(DRAFT)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  roomTypes RoomType[]
  rooms     Room[]
  members   HotelMember[]
  images    HotelImage[]

  inventories Inventory[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model HotelMember {
  hotelId String
  userId  String

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user  User  @relation("UserHotelMemberships", fields: [userId], references: [id])

  @@id([hotelId, userId])
  @@index([userId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  roles       RolePermission[]
  apiPolicies ApiActionPolicy[]
}

model UserRole {
  user   User   @relation(fields: [userId], references: [id])
  userId String
  role   Role   @relation(fields: [roleId], references: [id])
  roleId String

  @@id([userId, roleId])
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String

  @@id([roleId, permissionId])
}

model AuthSession {
  id          String       @id @default(cuid())
  userId      String
  jti         String       @unique
  refreshHash String
  provider    AuthProvider @default(LOCAL)

  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revokedBy String?
  reason    String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerifyToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @db.VarChar(64)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model ApiAction {
  id          String            @id @default(cuid())
  key         String            @unique // ví dụ: "hotel.update"
  description String?
  enabled     Boolean           @default(true)
  mode        PolicyMode        @default(ANY)
  policies    ApiActionPolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiActionPolicy {
  action       ApiAction  @relation(fields: [actionId], references: [id])
  actionId     String
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String

  @@id([actionId, permissionId])
}

model ImageAsset {
  id        String @id @default(cuid())
  // publicId là định danh xoá trên Cloudinary (bắt buộc để delete)
  publicId  String @unique
  url       String
  secureUrl String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Liên kết 1-1 cho avatar user (optional)
  userAvatarOf User[] @relation("UserAvatar")

  // Liên kết N-N có payload cho Hotel/RoomType/Location qua các bảng nối
}

model ImageGallery {
  id        String @id @default(cuid())
  publicId  String @unique
  url       String
  secureUrl String

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    String
  folderId  String
  folder    FolderGallery @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FolderGallery {
  id         String         @id @default(cuid())
  folderName String         @unique
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  galleries  ImageGallery[]
}

model HotelImage {
  id      String @id @default(cuid())
  hotelId String
  url     String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model RoomType {
  id              String  @id @default(cuid())
  hotelId         String
  name            String
  price_per_night Decimal @db.Decimal(12, 2)
  max_guests      Int
  description     String?

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  rooms     Room[]
  amenities RoomTypeAmenity[]
  images    RoomTypeImage[]
  bookingItems BookingItem[]
  inventories Inventory[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([hotelId, name])
  @@index([hotelId])
}

model Amenity {
  id        String  @id @default(cuid())
  key       String  @unique // vd: "Wifi", "AirVent", "Coffee"
  label     String // vd: "Wi-Fi", "Máy lạnh", "Cà phê miễn phí"
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  roomTypes RoomTypeAmenity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomTypeAmenity {
  typeId    String
  amenityId String

  roomType RoomType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([typeId, amenityId])
  @@index([amenityId])
}

model RoomTypeImage {
  id         String   @id @default(cuid())
  roomTypeId String
  url        String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
}

model Room {
  id         String @id @default(cuid())
  hotelId    String
  roomTypeId String

  code  String // ví dụ: "101", "A-1203"
  floor String?
  note  String?

  status      RoomStatus      @default(ACTIVE)
  cleanStatus RoomCleanStatus @default(CLEAN)

  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([hotelId, code])
  @@index([hotelId, roomTypeId])
}

model Inventory {
  id String @id @default(cuid())

  hotelId    String
  roomTypeId String

  date DateTime @db.Date

  totalRooms     Int @default(0)
  availableRooms Int @default(0)
  stopSell       Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, hotelId, date])
  @@index([hotelId, date])
  @@index([roomTypeId, date])
}

model Booking {
  id          String        @id @default(cuid())
  hotelId     String
  userId      String?       
  status      BookingStatus @default(PENDING)

  checkIn     DateTime
  checkOut    DateTime

  guestName   String
  guestEmail  String?
  guestPhone  String?

  totalAmount Decimal @db.Decimal(12, 2) @default(0) 
  note        String?
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       BookingItem[] 
  payments    Payment[]


  @@index([hotelId])
  @@index([userId])
}

model BookingItem {
  id         String  @id @default(cuid())
  bookingId  String
  roomTypeId String
  quantity   Int

  unitPrice  Decimal @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)

  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType   RoomType  @relation(fields: [roomTypeId], references: [id])

  @@index([bookingId])
  @@index([roomTypeId])
}


enum PaymentProvider {
  VNPAY
}

enum PaymentStatus {
  INIT        // vừa tạo attempt, đã build paymentUrl
  PENDING     // chờ IPN xác nhận (sau redirect)
  SUCCEEDED
  FAILED
  CANCELED
  REFUND_PENDING
  REFUNDED
}

model Payment {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  status      PaymentStatus   @default(INIT)

  bookingId   String
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Amount lưu theo đơn vị VND (giống booking.totalAmount)
  amount      Decimal         @db.Decimal(12, 2)

  // vnp_TxnRef: mã giao dịch phía merchant (bạn tự sinh)
  merchantTxnRef String       @unique

  // VNPAY fields (lưu những cái cần đối soát)
  vnpTransactionNo String?    // vnp_TransactionNo
  bankCode        String?     // vnp_BankCode
  payDate         DateTime?   // vnp_PayDate (parse từ YYYYMMDDHHmmss)
  responseCode    String?     // vnp_ResponseCode
  transactionStatus String?   // vnp_TransactionStatus

  // checksum/audit
  secureHashAlg  String?      // sha512
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  events        PaymentEvent[]
  @@index([bookingId])
  @@index([provider, status])
}

model PaymentEvent {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  type       String   // "RETURN" | "IPN" | "QUERYDR" | "REFUND"
  payload    Json
  createdAt  DateTime @default(now())

  @@index([paymentId])
}
// ==================== ENUM ====================
enum AuthProvider {
  LOCAL
  GOOGLE
}

enum PolicyMode {
  ANY // chỉ cần 1 quyền trong danh sách
  ALL // cần đủ toàn bộ quyền
}

enum ImageKind {
  AVATAR // avatar user
  COVER // ảnh bìa/cover
  GALLERY // ảnh trong bộ sưu tập
  DOC // tài liệu/biên lai nếu cần
}

enum HotelMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum HotelStatus {
  DRAFT // mới tạo, chưa public/hoạt động
  ACTIVE // đang hoạt động
  SUSPENDED // bị khoá/tạm dừng
  ARCHIVED // lưu trữ/ngừng kinh doanh
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum RoomCleanStatus {
  CLEAN
  DIRTY
  INSPECT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}